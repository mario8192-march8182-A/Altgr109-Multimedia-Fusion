<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AkpEditor.Mobile.Views.ProjectSettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Project Settings" FontSize="24" FontAttributes="Bold" />
            
            <StackLayout Spacing="5">
                <Label Text="Project Name" FontAttributes="Bold" />
                <Entry Placeholder="Enter project name" Text="{Binding ProjectName}" />
            </StackLayout>

            <StackLayout Spacing="5">
                <Label Text="Screen Width (px)" FontAttributes="Bold" />
                <Entry Placeholder="800" Text="{Binding ScreenWidth}" Keyboard="Numeric" />
            </StackLayout>

            <StackLayout Spacing="5">
                <Label Text="Screen Height (px)" FontAttributes="Bold" />
                <Entry Placeholder="600" Text="{Binding ScreenHeight}" Keyboard="Numeric" />
            </StackLayout>

            <StackLayout Spacing="5">
                <Label Text="Target FPS" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" />
            </StackLayout>

            <Button Text="Save Settings" Margin="0,20,0,0" />
            <Button Text="Export Project" BackgroundColor="#2196F3" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>